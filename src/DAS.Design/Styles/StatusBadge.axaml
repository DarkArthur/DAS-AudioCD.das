<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DAS.Design.Controls">
  <Style Selector="controls|DasStatusBadge">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontFamily" Value="{DynamicResource Das.Font.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Das.Text.Caption.Size}" />
    <Setter Property="FontWeight" Value="{DynamicResource Das.Font.Weight.SemiBold}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding Foreground}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Das.Radius.Pill}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <controls:DasIcon IconName="{TemplateBinding IconName}" Size="16"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center" />
            <TextBlock Text="{TemplateBinding DisplayText}"
                       Foreground="{TemplateBinding Foreground}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|DasStatusBadge:ok">
    <Setter Property="Background" Value="{DynamicResource Das.Brush.Status.OkSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Das.Brush.Status.Ok}" />
  </Style>
  <Style Selector="controls|DasStatusBadge:warn">
    <Setter Property="Background" Value="{DynamicResource Das.Brush.Status.WarnSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Das.Brush.Status.Warn}" />
  </Style>
  <Style Selector="controls|DasStatusBadge:ko">
    <Setter Property="Background" Value="{DynamicResource Das.Brush.Status.KoSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Das.Brush.Status.Ko}" />
  </Style>
</Styles>
