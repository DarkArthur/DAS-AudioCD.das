<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DAS.Design.Controls"
             xmlns:vm="using:DiscCheck.App.ViewModels"
             x:Class="DiscCheck.App.Views.DriveView"
             x:DataType="vm:DriveViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="{DynamicResource Das.Space.2}">
      <controls:DasIcon IconName="das.drive.optical" Size="24"
                        Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Text="Drive"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource Das.Font.Primary}"
                 FontSize="{DynamicResource Das.Text.Title.Size}"
                 FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <Button Classes="secondary" Content="Aggiorna" Command="{Binding RefreshCommand}" />
      <Button Classes="secondary" Command="{Binding ResetDriveCommand}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
          <controls:DasIcon IconName="das.reset" Size="16"
                            Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Text="Reset drive" />
        </StackPanel>
      </Button>
    </StackPanel>

    <Border DockPanel.Dock="Top"
            Classes="card"
            Margin="0,16,0,0"
            IsVisible="{Binding HasEmptyMessage}">
      <TextBlock Classes="Body" Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Das.Brush.Text}" />
    </Border>

    <Border DockPanel.Dock="Top"
            Classes="card"
            Margin="0,16,0,0"
            IsVisible="{Binding HasResetMessage}"
            Background="{DynamicResource Das.Brush.SurfaceAlt}">
      <TextBlock Classes="Body" Text="{Binding ResetMessage}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Das.Brush.Text}" />
    </Border>

    <ListBox ItemsSource="{Binding Drives}"
             SelectedItem="{Binding SelectedDrive}"
             Margin="0,16,0,0"
             Background="{DynamicResource Das.Brush.Background}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:DriveItemViewModel">
          <StackPanel Spacing="{DynamicResource Das.Space.1}">
            <TextBlock Text="{Binding Title}"
                       FontFamily="{DynamicResource Das.Font.Primary}"
                       FontSize="{DynamicResource Das.Text.BodyLarge.Size}"
                       FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                       Foreground="{DynamicResource Das.Brush.Text}" />
            <TextBlock Classes="Body" Text="{Binding Detail}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Das.Brush.Status.Ko}"
                       IsVisible="{Binding !IsIdentified}" />
            <StackPanel IsVisible="{Binding IsIdentified}" Spacing="{DynamicResource Das.Space.1}">
              <TextBlock Classes="Body" Text="{Binding Firmware, StringFormat='Firmware: {0}'}"
                         Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              <TextBlock Classes="Body" Text="{Binding C2Support, StringFormat='Puntatori C2: {0}'}"
                         Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              <TextBlock Classes="Body" Text="{Binding ReadOffset, StringFormat='Read offset: {0}'}"
                         Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              <TextBlock Classes="Body" Text="{Binding Cache, StringFormat='Cache: {0}'}"
                         Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              <TextBlock Classes="Body" Text="{Binding C2Reliability, StringFormat='Affidabilità C2: {0}'}"
                         Foreground="{DynamicResource Das.Brush.TextSecondary}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
