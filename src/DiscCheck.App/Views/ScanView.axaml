<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DAS.Design.Controls"
             xmlns:charts="using:DAS.Design.Charts"
             xmlns:vm="using:DiscCheck.App.ViewModels"
             x:Class="DiscCheck.App.Views.ScanView"
             x:DataType="vm:ScanViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="{DynamicResource Das.Space.2}">
      <controls:DasIcon IconName="disccheck.scan.pulse" Size="24"
                        Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Text="Scansione"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource Das.Font.Primary}"
                 FontSize="{DynamicResource Das.Text.Title.Size}"
                 FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Classes="Body" Text="Velocità" VerticalAlignment="Center" Margin="16,0,0,0"
                 Foreground="{DynamicResource Das.Brush.TextSecondary}" />
      <ComboBox ItemsSource="{Binding Speeds}"
                SelectedItem="{Binding SelectedSpeed}"
                IsEnabled="{Binding IsIdle}"
                MinWidth="110">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScanSpeedOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox Content="Forza scanner standard"
                IsChecked="{Binding ForceStandard}"
                IsEnabled="{Binding IsIdle}" />
      <Button Classes="primary" Content="Avvia" Command="{Binding StartCommand}" />
      <Button Classes="secondary" Content="Annulla" Command="{Binding CancelCommand}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Spacing="{DynamicResource Das.Space.1}">
      <TextBlock Classes="Body" Text="{Binding ScannerName, StringFormat='Scanner: {0}'}"
                 IsVisible="{Binding ScannerName, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Classes="Body" Text="{Binding ScannerMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding HasScannerMessage}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Classes="Body" Text="{Binding AvailabilityMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding HasAvailabilityMessage}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Classes="Body" Text="{Binding SpeedNote}" TextWrapping="Wrap"
                 IsVisible="{Binding HasSpeedNote}"
                 Foreground="{DynamicResource Das.Brush.TextSecondary}" />
      <Border Classes="card" IsVisible="{Binding HasSpeedConfirm}">
        <StackPanel Spacing="{DynamicResource Das.Space.2}">
          <TextBlock Classes="Body" Text="{Binding SpeedConfirmMessage}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
            <Button Classes="primary" Content="Conferma" Command="{Binding ConfirmSpeedCommand}" />
            <Button Classes="secondary" Content="Annulla" Command="{Binding CancelSpeedCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Classes="Body" Text="{Binding ComparisonWarningText}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Das.Brush.TextSecondary}" />
      <TextBlock Classes="Body" Text="{Binding StandardNoteText}" TextWrapping="Wrap"
                 IsVisible="{Binding ShowStandardNote}"
                 Foreground="{DynamicResource Das.Brush.TextSecondary}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Orientation="Horizontal"
                Spacing="{DynamicResource Das.Space.4}" IsVisible="{Binding HasStatusText}">
      <TextBlock Classes="Body" Text="{Binding StatusText, StringFormat='Stato: {0}'}"
                 VerticalAlignment="Center" Foreground="{DynamicResource Das.Brush.Text}" />
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="240"
                   IsVisible="{Binding IsRunning}" />
      <TextBlock Classes="Body" Text="{Binding SpeedText, StringFormat='Velocità: {0}'}"
                 VerticalAlignment="Center" IsVisible="{Binding IsRunning}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Orientation="Horizontal"
                Spacing="{DynamicResource Das.Space.2}" IsVisible="{Binding HasSaveMessage}">
      <TextBlock Classes="Body" Text="{Binding SaveMessage}" TextWrapping="Wrap"
                 VerticalAlignment="Center" Foreground="{DynamicResource Das.Brush.Text}" />
      <Button Classes="secondary" Content="Riprova salvataggio" Command="{Binding RetrySaveCommand}"
              IsVisible="{Binding SaveFailed}" />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="card" Margin="0,8,0,0"
            Background="{DynamicResource Das.Brush.Status.KoSurface}"
            BorderBrush="{DynamicResource Das.Brush.Status.Ko}"
            IsVisible="{Binding HasErrorMessage}">
      <StackPanel Spacing="{DynamicResource Das.Space.1}">
        <TextBlock Classes="Body" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Das.Brush.Text}" />
        <TextBlock Classes="Body" Text="{Binding ResetHintText}" TextWrapping="Wrap"
                   IsVisible="{Binding ShowResetDriveHint}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
        <StackPanel IsVisible="{Binding OfferStandardFallback}" Spacing="{DynamicResource Das.Space.1}">
          <TextBlock Classes="Body" Text="{Binding FallbackOfferText}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
            <Button Classes="primary" Content="Accetta" Command="{Binding AcceptFallbackCommand}" />
            <Button Classes="secondary" Content="Rifiuta" Command="{Binding DeclineFallbackCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0" IsVisible="{Binding HasSummary}">
      <StackPanel Spacing="{DynamicResource Das.Space.2}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
          <controls:DasStatusBadge Status="{Binding VerdictStatus}" IsVisible="{Binding HasVerdict}" />
          <TextBlock Classes="Body" Text="{Binding C1Total, StringFormat='C1 totale: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C1Mean, StringFormat='C1 medio: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C1Max, StringFormat='C1 massimo: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C2Total, StringFormat='C2 totale: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C2Max, StringFormat='C2 massimo: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding CuTotal, StringFormat='CU totale: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
        </StackPanel>
        <TextBlock Classes="Body" Text="{Binding LiteOnNoteText}" TextWrapping="Wrap"
                   IsVisible="{Binding ShowLiteOnNote}"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <TextBlock Classes="Body" Text="{Binding MediaTekWarningText}" TextWrapping="Wrap"
                   IsVisible="{Binding ShowMediaTekWarning}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Orientation="Horizontal"
                Spacing="{DynamicResource Das.Space.2}">
      <controls:DasIcon IconName="disccheck.chart.errors" Size="16"
                        Foreground="{DynamicResource Das.Brush.Text}" />
      <CheckBox Content="Mostra soglie" IsChecked="{Binding ShowThresholds}" />
      <Button Classes="secondary" Command="{Binding ExportCsvCommand}"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}"><controls:DasIcon IconName="das.export.csv" Size="16" Foreground="{DynamicResource Das.Brush.Text}" /><TextBlock Text="Esporta CSV" /></StackPanel></Button>
      <Button Classes="secondary" Command="{Binding ExportPngCommand}"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}"><controls:DasIcon IconName="das.export.png" Size="16" Foreground="{DynamicResource Das.Brush.Text}" /><TextBlock Text="Esporta PNG" /></StackPanel></Button>
      <Button Classes="secondary" Content="Esporta SVG" Command="{Binding ExportSvgCommand}" />
      <Button Classes="secondary" Command="{Binding ExportHtmlCommand}"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}"><controls:DasIcon IconName="das.export.html" Size="16" Foreground="{DynamicResource Das.Brush.Text}" /><TextBlock Text="Report HTML" /></StackPanel></Button>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="Body" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="{Binding ExportMessage}" IsVisible="{Binding HasExportMessage}"
               Foreground="{DynamicResource Das.Brush.Text}" />

    <charts:DasChartView x:Name="Chart"
                         Margin="0,8,0,0"
                         MinHeight="280"
                         Series="{Binding ChartSeriesList}"
                         AxisSpec="{Binding AxisSpec}"
                         Thresholds="{Binding ChartThresholds}" />
  </DockPanel>
</UserControl>
