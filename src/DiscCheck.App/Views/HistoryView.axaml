<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DAS.Design.Controls"
             xmlns:charts="using:DAS.Design.Charts"
             xmlns:vm="using:DiscCheck.App.ViewModels"
             x:Class="DiscCheck.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="{DynamicResource Das.Space.2}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
        <controls:DasIcon IconName="das.history" Size="24"
                          Foreground="{DynamicResource Das.Brush.Text}" />
        <TextBlock Text="Storico"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Das.Font.Primary}"
                   FontSize="{DynamicResource Das.Text.Title.Size}"
                   FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
      </StackPanel>

      <Border Classes="card"
              Background="{DynamicResource Das.Brush.Status.KoSurface}"
              BorderBrush="{DynamicResource Das.Brush.Status.Ko}"
              IsVisible="{Binding HasLoadError}">
        <TextBlock Classes="Body" Text="{Binding LoadError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Das.Brush.Text}" />
      </Border>

      <!-- Filters (Requirement 17.2) -->
      <WrapPanel Orientation="Horizontal">
        <TextBlock Classes="Body" Text="Supporto" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <TextBox Text="{Binding MediumFilter}" Width="160" Margin="0,0,16,0" />
        <TextBlock Classes="Body" Text="Velocità (x)" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <TextBox Text="{Binding SpeedFilter}" Width="70" Margin="0,0,16,0" />
        <TextBlock Classes="Body" Text="Dal" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <CalendarDatePicker SelectedDate="{Binding FromDate}" Margin="0,0,16,0" />
        <TextBlock Classes="Body" Text="Al" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <CalendarDatePicker SelectedDate="{Binding ToDate}" Margin="0,0,16,0" />
        <CheckBox Content="OK" IsChecked="{Binding FilterOk}" />
        <CheckBox Content="WARN" IsChecked="{Binding FilterWarn}" />
        <CheckBox Content="KO" IsChecked="{Binding FilterKo}" Margin="0,0,16,0" />
        <Button Classes="secondary" Content="Azzera filtri" Command="{Binding ClearFiltersCommand}" />
      </WrapPanel>
      <TextBlock Classes="Body" Text="{Binding FilterError}" TextWrapping="Wrap"
                 IsVisible="{Binding HasFilterError}"
                 Foreground="{DynamicResource Das.Brush.Text}" />

      <!-- Discs -->
      <TextBlock Classes="Body" Text="Dischi" FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Classes="Body" Text="{Binding DiscsEmptyMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding HasDiscsEmptyMessage}"
                 Foreground="{DynamicResource Das.Brush.TextSecondary}" />
      <ListBox ItemsSource="{Binding Discs}" MaxHeight="180"
               Background="{DynamicResource Das.Brush.Background}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DiscRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
              <TextBlock Text="{Binding LastActivity}" Width="140" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Label}" Width="200" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Medium}" Width="240" Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracce'}" Foreground="{DynamicResource Das.Brush.TextSecondary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Scans -->
      <TextBlock Classes="Body" Text="Scansioni" FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Classes="Body" Text="{Binding ScansEmptyMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding HasScansEmptyMessage}"
                 Foreground="{DynamicResource Das.Brush.TextSecondary}" />
      <ListBox ItemsSource="{Binding Scans}" SelectedItem="{Binding SelectedScan}" MaxHeight="220"
               Background="{DynamicResource Das.Brush.Background}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScanRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
              <TextBlock Text="{Binding Date}" Width="140" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Disc}" Width="180" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Drive}" Width="180" Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              <TextBlock Text="{Binding Speed}" Width="50" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Scanner}" Width="90" Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              <controls:DasStatusBadge Status="{Binding Status}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
        <Button Classes="secondary" Content="Elimina scansione" Command="{Binding DeleteCommand}" />
        <TextBlock Classes="Body" Text="{Binding DeleteMessage}" TextWrapping="Wrap"
                   VerticalAlignment="Center" IsVisible="{Binding HasDeleteMessage}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
      </StackPanel>
      <Border Classes="card" IsVisible="{Binding HasPendingDelete}">
        <StackPanel Spacing="{DynamicResource Das.Space.2}">
          <TextBlock Classes="Body" Text="{Binding PendingDeleteText}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
            <Button Classes="primary" Content="Conferma eliminazione" Command="{Binding ConfirmDeleteCommand}" />
            <Button Classes="secondary" Content="Annulla" Command="{Binding CancelDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Selected scan: summary and chart (Requirement 17.4) -->
      <Border Classes="card" IsVisible="{Binding HasScanDetail}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
          <controls:DasStatusBadge Status="{Binding DetailStatus}" />
          <TextBlock Classes="Body" Text="{Binding C1Total, StringFormat='C1 totale: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C1Mean, StringFormat='C1 medio: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C1Max, StringFormat='C1 massimo: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C2Total, StringFormat='C2 totale: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding C2Max, StringFormat='C2 massimo: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="{Binding CuTotal, StringFormat='CU totale: {0}'}"
                     Foreground="{DynamicResource Das.Brush.Text}" />
        </StackPanel>
      </Border>
      <TextBlock Classes="Body" Text="{Binding DetailError}" TextWrapping="Wrap"
                 IsVisible="{Binding HasDetailError}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <CheckBox Content="Mostra soglie" IsChecked="{Binding ShowThresholds}" />
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
        <Button Classes="secondary" Command="{Binding ExportCsvCommand}"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}"><controls:DasIcon IconName="das.export.csv" Size="16" Foreground="{DynamicResource Das.Brush.Text}" /><TextBlock Text="Esporta CSV" /></StackPanel></Button>
        <Button Classes="secondary" Command="{Binding ExportPngCommand}"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}"><controls:DasIcon IconName="das.export.png" Size="16" Foreground="{DynamicResource Das.Brush.Text}" /><TextBlock Text="Esporta PNG" /></StackPanel></Button>
        <Button Classes="secondary" Content="Esporta SVG" Command="{Binding ExportSvgCommand}" />
        <Button Classes="secondary" Command="{Binding ExportHtmlCommand}"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}"><controls:DasIcon IconName="das.export.html" Size="16" Foreground="{DynamicResource Das.Brush.Text}" /><TextBlock Text="Report HTML" /></StackPanel></Button>
      </StackPanel>
      <TextBlock Classes="Body" TextWrapping="Wrap" Text="{Binding ExportMessage}"
                 IsVisible="{Binding HasExportMessage}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <charts:DasChartView x:Name="Chart"
                           MinHeight="280"
                           Series="{Binding ChartSeriesList}"
                           AxisSpec="{Binding AxisSpec}"
                           Thresholds="{Binding ChartThresholds}" />

      <!-- Verifications -->
      <TextBlock Classes="Body" Text="Verifiche" FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <TextBlock Classes="Body" Text="{Binding VerificationsEmptyMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding HasVerificationsEmptyMessage}"
                 Foreground="{DynamicResource Das.Brush.TextSecondary}" />
      <ListBox ItemsSource="{Binding Verifications}" SelectedItem="{Binding SelectedVerification}" MaxHeight="180"
               Background="{DynamicResource Das.Brush.Background}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VerificationRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
              <TextBlock Text="{Binding Date}" Width="140" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Disc}" Width="200" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Result}" Width="90" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding OffsetUsed, StringFormat='offset {0}'}" Foreground="{DynamicResource Das.Brush.TextSecondary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="Body" Text="{Binding VerificationError}" TextWrapping="Wrap"
                 IsVisible="{Binding HasVerificationError}"
                 Foreground="{DynamicResource Das.Brush.Text}" />
      <ListBox ItemsSource="{Binding VerificationTracks}" MaxHeight="260"
               Background="{DynamicResource Das.Brush.Background}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VerificationTrackRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
              <TextBlock Text="{Binding TrackNo, StringFormat='Traccia {0:00}'}" Width="90"
                         Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Crc32}" Width="90" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Sha256}" Width="520" Foreground="{DynamicResource Das.Brush.Text}" />
              <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource Das.Brush.Text}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
