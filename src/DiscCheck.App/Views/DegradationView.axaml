<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DAS.Design.Controls"
             xmlns:charts="using:DAS.Design.Charts"
             xmlns:vm="using:DiscCheck.App.ViewModels"
             x:Class="DiscCheck.App.Views.DegradationView"
             x:DataType="vm:DegradationViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="{DynamicResource Das.Space.2}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
        <controls:DasIcon IconName="disccheck.archive.degradation" Size="24"
                          Foreground="{DynamicResource Das.Brush.Text}" />
        <TextBlock Text="Archivio e degrado"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Das.Font.Primary}"
                   FontSize="{DynamicResource Das.Text.Title.Size}"
                   FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
      </StackPanel>

      <!-- Load error: no partial trend or list is shown (Requirement 20.13) -->
      <Border Classes="card"
              Background="{DynamicResource Das.Brush.Status.KoSurface}"
              BorderBrush="{DynamicResource Das.Brush.Status.Ko}"
              IsVisible="{Binding HasLoadError}">
        <TextBlock Classes="Body" Text="{Binding LoadError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Das.Brush.Text}" />
      </Border>

      <StackPanel Spacing="{DynamicResource Das.Space.2}" IsVisible="{Binding HasData}">
        <!-- Overdue and due-soon discs (Requirement 20.5) -->
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
          <controls:DasIcon IconName="das.reminder.bell" Size="20"
                            Foreground="{DynamicResource Das.Brush.Text}" />
          <TextBlock Classes="Body" Text="Ricontrolli scaduti e in scadenza (90 giorni)"
                     FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Das.Brush.Text}" />
        </StackPanel>
        <TextBlock Classes="Body" Text="{Binding RecheckIntervalText}"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <TextBlock Classes="Body" Text="{Binding DueEmptyMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding HasDueEmptyMessage}"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <ListBox ItemsSource="{Binding DueDiscs}" MaxHeight="180"
                 Background="{DynamicResource Das.Brush.Background}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecheckRow">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
                <TextBlock Text="{Binding DueDate}" Width="120" Foreground="{DynamicResource Das.Brush.Text}" />
                <TextBlock Text="{Binding Label}" Width="260" Foreground="{DynamicResource Das.Brush.Text}" />
                <TextBlock Text="{Binding StatusText}" FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                           Foreground="{DynamicResource Das.Brush.Text}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Discs -->
        <TextBlock Classes="Body" Text="Dischi" FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
        <TextBlock Classes="Body" Text="{Binding DiscsEmptyMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding HasDiscsEmptyMessage}"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <ListBox ItemsSource="{Binding Discs}" SelectedItem="{Binding SelectedDisc}" MaxHeight="220"
                 Background="{DynamicResource Das.Brush.Background}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DegradationDiscRow">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
                <TextBlock Text="{Binding Label}" Width="260" Foreground="{DynamicResource Das.Brush.Text}" />
                <TextBlock Text="{Binding RecheckDue, StringFormat='Ricontrollo: {0}'}" Width="180"
                           Foreground="{DynamicResource Das.Brush.TextSecondary}" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.1}"
                            IsVisible="{Binding IsWorsening}">
                  <controls:DasIcon IconName="das.status.warning" Size="16"
                                    Foreground="{DynamicResource Das.Brush.Status.Warn}" />
                  <TextBlock Text="in peggioramento" FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                             Foreground="{DynamicResource Das.Brush.Text}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Trend of the selected disc (Requirements 20.1, 20.7, 20.10, 20.11, 20.14) -->
        <Border Classes="card"
                Background="{DynamicResource Das.Brush.Status.WarnSurface}"
                BorderBrush="{DynamicResource Das.Brush.Status.Warn}"
                IsVisible="{Binding IsWorsening}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.2}">
            <controls:DasIcon IconName="das.status.warning" Size="20"
                              Foreground="{DynamicResource Das.Brush.Status.Warn}" />
            <TextBlock Classes="Body" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Disco in peggioramento: il Verdetto dell'ultima scansione è peggiore di quello precedente."
                       Foreground="{DynamicResource Das.Brush.Text}" />
          </StackPanel>
        </Border>
        <TextBlock Classes="Body" Text="{Binding TrendMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding HasTrendMessage}"
                   Foreground="{DynamicResource Das.Brush.TextSecondary}" />
        <TextBlock Classes="Body" Text="{Binding TrendError}" TextWrapping="Wrap"
                   IsVisible="{Binding HasTrendError}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
        <ItemsControl ItemsSource="{Binding Charts}" IsVisible="{Binding HasCharts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TrendChart">
              <StackPanel Spacing="{DynamicResource Das.Space.1}" Margin="0,0,0,8">
                <TextBlock Classes="Body" Text="{Binding Title}"
                           FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                           Foreground="{DynamicResource Das.Brush.Text}" />
                <charts:DasChartView MinHeight="220"
                                     Series="{Binding Series}"
                                     AxisSpec="{Binding Axis}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Storage advice, longevity, BLER target (Requirements 20.8, 20.9) -->
        <TextBlock Classes="Body" Text="Suggerimenti di conservazione"
                   FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
        <ItemsControl ItemsSource="{Binding StorageAdvice}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="Body" Text="{Binding}" TextWrapping="Wrap"
                         Foreground="{DynamicResource Das.Brush.Text}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="Body" Text="Longevità per tipo di supporto"
                   FontWeight="{DynamicResource Das.Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
        <ItemsControl ItemsSource="{Binding Longevity}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LongevityRow">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Das.Space.4}">
                <TextBlock Classes="Body" Text="{Binding Medium}" Width="220"
                           Foreground="{DynamicResource Das.Brush.Text}" />
                <TextBlock Classes="Body" Text="{Binding Lifetime}"
                           Foreground="{DynamicResource Das.Brush.TextSecondary}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="Body" Text="{Binding BlerTarget}"
                   Foreground="{DynamicResource Das.Brush.Text}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
